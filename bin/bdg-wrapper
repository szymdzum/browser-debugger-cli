#!/bin/bash
# Wrapper for bdg that sets BDG_SESSION_DIR per-repo
#
# This wrapper isolates browser sessions by git repository, preventing
# conflicts when running bdg in multiple repos simultaneously.
#
# Installation:
#   Option 1: Symlink to PATH
#     ln -s /path/to/browser-debugger-cli/bin/bdg-wrapper ~/.local/bin/bdg
#
#   Option 2: Add to PATH
#     export PATH="/path/to/browser-debugger-cli/bin:$PATH"
#     alias bdg=bdg-wrapper
#
# Session directories are created at: /tmp/bdg-sessions/<repo-name>-<path-hash>/

set -euo pipefail

# Resolve a path through any chain of symlinks to the real file
resolve_path() {
    local path="$1" dir
    while [[ -L "$path" ]]; do
        dir="$(cd "$(dirname "$path")" && pwd)"
        path="$(readlink "$path")"
        [[ "$path" != /* ]] && path="$dir/$path"
    done
    echo "$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
}

# Find the actual bdg binary relative to this script
SCRIPT_PATH="$(resolve_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
BDG_BIN="${SCRIPT_DIR}/../dist/index.js"

# Fallback: another bdg on PATH, skipping this wrapper itself (it may be
# installed as "bdg"; exec-ing it would loop forever)
if [[ ! -x "$BDG_BIN" ]]; then
    BDG_BIN=""
    while IFS= read -r candidate; do
        if [[ "$(resolve_path "$candidate")" != "$SCRIPT_PATH" ]]; then
            BDG_BIN="$candidate"
            break
        fi
    done < <(type -ap bdg)
    if [[ -z "$BDG_BIN" ]]; then
        echo "Error: Cannot find bdg binary" >&2
        echo "Expected at: ${SCRIPT_DIR}/../dist/index.js (run 'npm run build') or another bdg on PATH" >&2
        exit 1
    fi
fi

# Session key: repo name plus a hash of its full path, so two repos with the
# same folder name never share a session ("default" outside a repo)
if REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    REPO_HASH="$(printf '%s' "$REPO_ROOT" | cksum | cut -d' ' -f1)"
    SESSION_KEY="$(basename "$REPO_ROOT")-${REPO_HASH}"
else
    SESSION_KEY="default"
fi

# Set session dir per-repo to isolate browser sessions
export BDG_SESSION_DIR="/tmp/bdg-sessions/${SESSION_KEY}"
mkdir -p "$BDG_SESSION_DIR"

# Run the actual bdg
exec "$BDG_BIN" "$@"
