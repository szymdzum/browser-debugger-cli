FROM node:22-alpine

# Chromium and the libraries it needs (Node comes from the base image)
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

# Chromium path for chrome-launcher
ENV CHROME_PATH=/usr/bin/chromium-browser

# Copy package files and build artifacts
WORKDIR /app
COPY package*.json ./
COPY dist ./dist
COPY README.md ./

# Remove prepare script from package.json (husky not needed in container)
RUN npm pkg delete scripts.prepare

# Install dependencies, then bdg globally
RUN npm install --omit=dev && npm install -g .

# Run as the unprivileged "node" user from the base image.
# bdg adds --no-sandbox automatically inside containers (Docker's default
# seccomp profile blocks Chrome's sandbox for every user).
USER node
WORKDIR /home/node

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD bdg --version || exit 1

# Default command shows help
CMD ["bdg", "--help"]
